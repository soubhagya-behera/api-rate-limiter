# Dependencies (installed inside the Docker build)
node_modules/

# Build output (generated inside the Docker build)
dist/
dist-ssr/

# Git
.git
.gitignore

# Environment files - never bake local values into the production build
.env
.env.local
.env.*.local

# IDE files
.idea
.vscode
*.sw?

# Logs and temporary files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Docker files themselves
Dockerfile
.dockerignore
